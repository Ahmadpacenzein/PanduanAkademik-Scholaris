{
  "expo": {
    "name": "scholaris-app",
    "slug": "scholaris-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.scholaris.panduanakademik",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "defaultChannel": "academic-updates",
          "color": "#6750A4"
        }
      ]
    ]
  }
}
